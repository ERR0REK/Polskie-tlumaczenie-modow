  "electroenergetics.ponder.tag.electricity_basics.description": "Jak działa elektryczność",
  "electroenergetics.ponder.third_rail.header": "Używanie trzeciej szyny",
  "electroenergetics.ponder.third_rail.text_1": "Pociągi elektryczne mogą pobierać zasilanie z trzeciej szyny",
  "electroenergetics.ponder.third_rail.text_2": "Służy do tego stopka stykowa szyny",
  "electroenergetics.ponder.transformer.header": "Zmiana napięcia",
  "electroenergetics.ponder.transformer.text_1": "Transformatory służą do zmiany napięcia.",
  "electroenergetics.ponder.transformer.text_2": "Po prostu ustaw przekładnię.",
  "electroenergetics.ponder.transformer_core_multiblock.header": "Podstawy rdzenia transformatora",
  "electroenergetics.ponder.transformer_core_multiblock.text_1": "Rdzenie transformatora można skonfigurować z określoną liczbą zwojów.",
  "electroenergetics.ponder.transformer_core_multiblock.text_2": "Otocz rdzeń transformatora panelami chłodnicy i zalej olejem transformatorowym, aby zwiększyć jego moc znamionową",
  "electroenergetics.ponder.transformer_core_multiblock.text_3": "Przekroczenie mocy znamionowej transformatora spowoduje jego przeciążenie.",
  "electroenergetics.ponder.transformer_losses.header": "Transformatory a straty energii",
  "electroenergetics.ponder.transformer_losses.text_1": "Przewody mają pewien opór, więc powodują straty energii.",
  "electroenergetics.ponder.transformer_losses.text_2": "299,5 V",
  "electroenergetics.ponder.transformer_losses.text_3": "299,4 V",
  "electroenergetics.ponder.transformer_losses.text_4": "10 A",
  "electroenergetics.ponder.transformer_losses.text_5": "Straty energii są wprost proporcjonalne do rezystancji i kwadratu natężenia prądu.",
  "electroenergetics.ponder.transformer_losses.text_6": "Transformatory pozwalają podnieść napięcie, a więc zmniejszyć natężenie prądu.",
  "electroenergetics.ponder.transformer_losses.text_7": "3,3 A",
  "electroenergetics.ponder.transformer_losses.text_8": "W długich liniach przesyłowych podniesienie napięcia znacznie zmniejsza straty energii.",
  "electroenergetics.ponder.transformer_turns.header": "Jak działają transformatory",
  "electroenergetics.ponder.transformer_turns.text_1": "Transformatory służą do podnoszenia lub obniżania napięcia",
  "electroenergetics.ponder.transformer_turns.text_2": "Zauważ, że przekładnia zwojów jest równa przekładni napięć",
  "electroenergetics.ponder.transformer_turns.text_3": "Co więcej, transformator nie łączy obu obwodów",
  "electroenergetics.ponder.transformer_turns.text_4": "Zamiast tego sprzęga je magnetycznie",
  "electroenergetics.ponder.voltage_introduction.header": "Czym jest napięcie?",
  "electroenergetics.ponder.voltage_introduction.text_1": "Napięcie to miara różnicy potencjałów elektrycznych",
  "electroenergetics.ponder.voltage_introduction.text_2": "Woltomierz mierzy różnicę napięć między dwoma punktami.",
  "electroenergetics.ponder.voltage_introduction.text_3": "Pamiętaj, że prąd jeszcze nie płynie!",
  "electroenergetics.ponder.voltage_introduction.text_4": "Pomyśl o napięciu jak o ciśnieniu, które wprawia prąd w ruch.",
  "electroenergetics.ponder.voltage_introduction.text_5": "Obecnie nie jest przenoszona żadna energia, bo prąd nie płynie.",
  "electroenergetics.ponder.voltage_introduction.text_6": "Po podłączeniu obciążenia do obwodu prąd zaczyna płynąć",
  "electroenergetics.ponder.voltage_introduction.text_7": "Im wyższe napięcie, tym większy płynie prąd",
  "electroenergetics.ponder.voltage_regulator.header": "Regulacja napięcia stabilizatorem",
  "electroenergetics.ponder.voltage_regulator.text_1": "Stabilizator napięcia pozwala regulować napięcie na bieżąco",
  "electroenergetics.ponder.voltage_regulator.text_2": "Podłącz źródło zasilania do górnego zacisku wejściowego",
  "electroenergetics.ponder.voltage_regulator.text_3": "Podłącz minus do dolnego zacisku uziemienia",
  "electroenergetics.ponder.voltage_regulator.text_4": "Podłącz obciążenie do zacisku wyjściowego",
  "electroenergetics.ponder.voltage_regulator.text_5": "Na koniec zamknij obwód",
  "electroenergetics.ponder.voltage_regulator.text_6": "Stabilizator ustawi napięcie wyjściowe tak blisko 300 V, jak to możliwe",
